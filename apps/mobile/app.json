{
  "expo": {
    "name": "Index des marques",
    "slug": "index-des-marques",
    "owner": "index-awareness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "indexdesmarques",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.indexdesmarques.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "L'appareil photo sert à lire le code-barres d'un produit. Aucune photo n'est gardée : seul le numéro du code est envoyé pour trouver la marque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5A2DE0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.indexdesmarques.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f2fb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "L'appareil photo sert à lire le code-barres d'un produit. Aucune photo n'est gardée : seul le numéro du code est envoyé pour trouver la marque.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "98895628-5edd-4267-a32c-83b0ca5d4e15"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/98895628-5edd-4267-a32c-83b0ca5d4e15"
    }
  }
}
