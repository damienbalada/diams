# Projet Supabase DIAMS
NEXT_PUBLIC_SUPABASE_URL=https://wvqbvmjsqihqzmygrkwq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Back-office /admin (revue des preuves, signalements) : clé SECRÈTE, variable
# serveur sans NEXT_PUBLIC_, jamais envoyée au navigateur.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OBLIGATOIRE pour ouvrir /admin — identifiants du back-office, DISTINCTS de ceux
# du site. Sans ADMIN_PASSWORD, /admin répond 503 (fermé).
ADMIN_USER=admin
ADMIN_PASSWORD=change-moi-aussi

# OBLIGATOIRE — mot de passe du site (HTTP Basic, cf. middleware.ts).
# Sans SITE_PASSWORD, le site répond 503 : c'est volontaire (fail-closed), pour
# qu'aucun identifiant par défaut ne traîne dans le dépôt. À définir dans
# Vercel → Settings → Environment Variables.
SITE_USER=diams
SITE_PASSWORD=change-moi

# Lancement public (presse) : SITE_PUBLIC=1 ouvre le site sans mot de passe ;
# le back-office reste protégé par ADMIN_PASSWORD.
# SITE_PUBLIC=1
